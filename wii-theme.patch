+        else speedView.setText("\u2193 " + rate((rx - lastRx) * 1000 / ms) + "   \u2191 " + rate((tx - lastTx) * 1000 / ms));
+        lastRx = rx;
+        lastTx = tx;
+        lastAt = now;
+    }
