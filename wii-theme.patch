+            o.inSampleSize = sample;
+            Bitmap bm = BitmapFactory.decodeByteArray(jpeg, 0, jpeg.length, o);
+            if (bm != null) avatar = new BitmapDrawable(getResources(), bm);
+        } catch (Throwable ignored) {}
+        return avatar;
+    }
